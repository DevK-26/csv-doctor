# DOMAIN comes from .env — ":80" means IP-only HTTP mode, a real
# domain like csvdoctor.example.com means automatic HTTPS via Let's Encrypt.
{$DOMAIN} {
	encode gzip

	# API: /api/health -> engine /health, /api/analyse -> engine /analyse
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy engine:7860
	}

	# Everything else goes to the Next.js web app
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
